{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/.well-known/apple-app-site-association",
      "headers": { "Content-Type": "application/json" },
      "continue": true
    },
    {
      "src": "/.well-known/assetlinks.json",
      "headers": { "Content-Type": "application/json" },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
